# Secrets
.env

# Machine-local Claude Code state
.claude/settings.local.json
.dm_session

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/

# Generated binary data (regeneratable)
global/*.db
global/monsters/

# Copyrighted reference material
campaigns/*/reference/
global/reference/dmg.txt
global/reference/monstermanual.txt
global/reference/phb.txt

# Generated images (regeneratable via API)
campaigns/*/images/*.png
campaigns/*/images/*.jpg
campaigns/*/images/*.webp

# Generated narration audio (regeneratable via TTS)
campaigns/*/audio/

# Scraped Greyhawk wiki images — ~300 MB, refetchable with the scraper.
# The DB snapshot itself (settings/greyhawk/greyhawk.db) stays tracked:
# it is the queryable reference the lookup tools read.
settings/*/images/

# Timestamped local backups of generated data
*.bak
*.bak.*
*.bak_*
