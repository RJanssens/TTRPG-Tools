{
  "name": "Barbarian",
  "source": "Complete Barbarian's Handbook (PHBR10) \u2014 Warrior subclass / kit",
  "source_url": "https://adnd2e.fandom.com/wiki/Barbarian",
  "description": "Tribal warriors raised in wilderness societies. Barbarians draw their strength from raw vitality and instinct rather than disciplined martial training. They use the Warrior THAC0 and saving-throw progressions, but roll d12 for hit points, follow a steeper XP track, eschew heavy plate armour, distrust most magic, and bring a suite of physical and wilderness abilities far beyond a baseline Fighter. They are typically illiterate at first level and must learn to read and write through extended exposure to civilised company.",
  "hit_die": "d12",
  "prime_requisite": [
    "strength",
    "constitution"
  ],
  "ability_requirements": {
    "str": 12,
    "dex": 9,
    "con": 12
  },
  "allowed_races": [
    "Human"
  ],
  "allowed_alignments": [
    "LG",
    "LN",
    "N",
    "NG",
    "CG"
  ],
  "allowed_armor": [
    "Padded",
    "Leather",
    "Studded Leather",
    "Hide"
  ],
  "weapon_specialization": false,
  "casts_spells": false,
  "base_movement_rate": 15,
  "weapon_proficiency_slots": {
    "initial": 4,
    "advance_every_levels": 3
  },
  "nonweapon_proficiency_slots": {
    "initial": 3,
    "advance_every_levels": 3
  },
  "special_abilities": [
    "Hit Die: d12 + CON HP adjustment per level (levels 1-9). At levels 10+, gain +3 HP per level (no further dice).",
    "XP, THAC0, and saves identical to Fighter; XP table is steeper than Fighter's (see levels).",
    "Attacks per round: 1/round (L1-6), 3/2 rounds (L7-12), 2/round (L13+). Same as Fighter.",
    "Cannot Weapon Specialize. May take Weapon Expertise (Player's Option: Combat & Tactics) \u2014 extra attacks without to-hit/damage bonus.",
    "Cannot wear plate mail, field plate, or full plate. Allowed: padded, leather, studded leather, hide.",
    "Cannot cast spells. May use most magic items: potions, protection scrolls, most rings, enchanted armor/weapons/shields.",
    "Base movement rate 15 (vs 12 for most warriors). +3 movement bonus when encumbered.",
    "Restricted weapons: stone/wood/bone construction only \u2014 axe (hand/battle/throwing), blowgun, short bow, club, dagger, dart, harpoon, javelin, knife, quarterstaff, sling (stones), spear.",
    "Starts knowing Survival, Hiding, and Animal Lore proficiencies for free, applicable in the homeland terrain only.",
    "Homeland Terrain bonuses: opponents take -2 surprise penalty when the barbarian moves stealthily; auto-Tracking proficiency in homeland terrain.",
    "Illiterate at first level: must spend 1 year of downtime per language to learn to read and write (50% chance per attempt).",
    "Two-weapon fighting penalties per Table 7 (-2 main / -4 off-hand at DEX 6-15, scaling with DEX).",
    "Attacks of opportunity (Combat & Tactics): 1 + 1 per 5 levels."
  ],
